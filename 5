#include <iostream>
#include <string>

using namespace std;

int main() {
    int choice;
    cout << "Conversion Menu:\n";
    cout << "1. Decimal to Binary\n";
    cout << "2. Binary to Decimal\n";
    cout << "3. Decimal to Hexadecimal\n";
    cout << "4. Hexadecimal to Decimal\n";
    cout << "Enter choice: ";
    cin >> choice;

    if (choice == 1) {
        int dec;
        cout << "Enter a decimal number: ";
        cin >> dec;

        string bin = "";
        if (dec == 0) bin = "0";
        while (dec > 0) {
            bin = to_string(dec % 2) + bin;
            dec /= 2;
        }
        cout << "Binary representation: " << bin << endl;

    } else if (choice == 2) {
        string bin;
        cout << "Enter a binary number: ";
        cin >> bin;
        // stoi(string, position_pointer, base) converts binary (base 2) to decimal
        cout << "Decimal representation: " << stoi(bin, nullptr, 2) << endl;

    } else if (choice == 3) {
        int dec;
        cout << "Enter a decimal number: ";
        cin >> dec;
        // hex manipulator converts decimal output to hexadecimal
        cout << "Hexadecimal representation: " << hex << uppercase << dec << endl;

    } else if (choice == 4) {
        string hexVal;
        cout << "Enter a hexadecimal number: ";
        cin >> hexVal;
        // stoi converts hexadecimal (base 16) to decimal
        cout << "Decimal representation: " << stoi(hexVal, nullptr, 16) << endl;

    } else {
        cout << "Invalid choice!" << endl;
    }

    return 0;
}
